# ─── Server ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Database ───────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ─── JWT ────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_key_here
JWT_EXPIRES=7d

# ─── Telegram ───────────────────────────────────────────────
# @BotFather dan olingan token
BOT_TOKEN=7xxxxxxxxx:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# @gk_ipoteka kanal ID (minus bilan)
# Olish: https://api.telegram.org/botTOKEN/getUpdates
CHANNEL_PUBLIC=-100xxxxxxxxxx

# Agentlar guruhi ID (ixtiyoriy — to'liq ma'lumot uchun)
# CHANNEL_AGENTS=-100xxxxxxxxxx

# Webhook URL (Railway deploy manzili)
# WEBHOOK_URL=https://your-app.up.railway.app/webhook

# ─── Cloudinary ─────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
